# Virtual Environment (ვირტუალური გარემო)
.venv/
venv/
ENV/
env/

# Sensitive files (პრივატული გასაღებები)
.env

# Database (ლოკალური მონაცემთა ბაზა)
db.sqlite3
*.sqlite3

# Python Bytecode & Cache (დროებითი ქეშ-ფაილები)
__pycache__/
*.py[cod]
*$py.class

# IDE & Editor files (რედაქტორის პარამეტრები)
.vscode/
.idea/
*.swp
*.swo

# OS generated files (ოპერაციული სისტემის ფაილები)
.DS_Store
Thumbs.db

# Logs & Media (თუ სურათებს ატვირთავ ლოკალურად)
*.log
media/